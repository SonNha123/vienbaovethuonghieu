@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="row justify-content-center my-5 py-5">
    <div class="col-md-6 col-12 text-center bg-white border rounded-3 p-5 shadow-sm">
        <i class="fa-solid fa-triangle-exclamation text-danger display-1 mb-4"></i>
        <h2 class="brand-font text-uppercase text-danger mb-3">Từ chối truy cập</h2>
