        <div class="d-flex gap-3 justify-content-center">
            <a href="http://localhost:5000" class="btn btn-primary rounded-pill font-monospace fw-bold px-4">Về Trang chủ</a>
            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-secondary rounded-pill font-monospace fw-bold px-4">Đăng nhập tài khoản khác</a>
