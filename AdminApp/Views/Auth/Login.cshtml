@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5 col-12">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="sidebar-header d-flex flex-column align-items-center text-center py-3" style="border-bottom: 1px blue #0062ff; background-color: rgb(0, 85, 255);">
                <img src="/uploads/logos/logo.png" alt="Logo" class="img-fluid mb-2" style="max-height: 75px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));" />
                <span class="d-block text-white fw-bold" style="font-size: 0.68rem; line-height: 1.4; text-transform: uppercase; letter-spacing: 0.3px; max-width: 220px;">Viện phát triển bảo vệ thương hiệu và chống hàng giả</span>
            </div>
            <div class="card-body p-4 bg-white">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })
                    
                    <div class="mb-3">
                        <label for="username" class="form-label fw-bold text-secondary">Tên tài khoản</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-user"></i></span>
                            <input type="text" class="form-control" id="username" name="username" placeholder="Nhập tên đăng nhập..." required />
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label for="password" class="form-label fw-bold text-secondary">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-lock"></i></span>
                            <input type="password" class="form-control" id="password" name="password" placeholder="Nhập mật khẩu..." required />
                        </div>
                    </div>
                    
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold text-uppercase" style="font-size: 0.95rem;">Đăng nhập <i class="fa-solid fa-arrow-right-to-bracket ms-2"></i></button>
                    </div>

                    <div class="text-center">
                        <span class="small text-muted">Doanh nghiệp thành viên? <a asp-action="Register" class="text-decoration-none fw-bold text-primary">Đăng ký tài khoản</a></span>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
