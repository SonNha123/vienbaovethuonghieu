@model List<New_folder.Models.PartnerLogo>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Logo Doanh nghiệp";
}

<div class="row g-4">
    <!-- LEFT SIDE: ADD LOGO FORM (40%) -->
    <div class="col-lg-4 col-12">
        <div class="admin-card">
            <h4 class="brand-font fs-5 text-secondary text-uppercase mb-4"><i class="fa-solid fa-square-plus me-2 text-primary"></i> Upload Logo Mới</h4>
            <form asp-action="CreatePartnerLogo" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary">Tên Doanh nghiệp thành viên <span class="text-danger">*</span></label>
                    <input type="text" name="companyName" class="form-control" placeholder="Ví dụ: Công ty iCheck" required />
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary">Ảnh Logo <span class="text-danger">*</span></label>
                    <input type="file" name="logoFile" class="form-control" accept="image/*" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary">Liên kết Website của Doanh nghiệp</label>
                    <input type="url" name="websiteUrl" class="form-control" placeholder="Ví dụ: https://icheck.com.vn" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary">Thứ tự hiển thị (Sắp xếp)</label>
                    <input type="number" name="displayOrder" class="form-control" value="0" min="0" required />
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary fw-bold text-uppercase rounded-3"><i class="fa-solid fa-cloud-arrow-up me-2"></i> Xuất bản Logo</button>
                </div>
            </form>
        </div>
    </div>

    <!-- RIGHT SIDE: LOGOS LISTING (60%) -->
    <div class="col-lg-8 col-12">
        <div class="admin-card">
            <h4 class="brand-font fs-5 text-secondary text-uppercase mb-4"><i class="fa-solid fa-building me-2 text-warning"></i> Danh sách Logo đối tác chiến lược</h4>
            
            <!-- SEARCH AND FILTER CONTROLS -->
            <div class="row g-3 mb-4 p-3 bg-light rounded-3 border">
                <div class="col-md-7 col-12">
                    <label class="form-label fw-bold text-secondary small"><i class="fa-solid fa-magnifying-glass me-1"></i>Tìm kiếm</label>
                    <input type="text" id="logoSearchInput" class="form-control shadow-sm" placeholder="Tìm theo tên doanh nghiệp..." />
                </div>
                <div class="col-md-5 col-12">
                    <label class="form-label fw-bold text-secondary small"><i class="fa-solid fa-circle-check me-1"></i>Trạng thái hiển thị</label>
                    <select id="logoStatusFilter" class="form-select shadow-sm">
                        <option value="">Tất cả trạng thái</option>
                        <option value="active">Đang hiển thị ở chân trang</option>
                        <option value="inactive">Không hiển thị (Tắt)</option>
                    </select>
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr class="table-light">
                                <th>Ảnh Logo</th>
                                <th>Doanh nghiệp</th>
                                <th>Liên kết</th>
                                <th class="text-center">Thứ tự</th>
                                <th class="text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="logosTableBody">
                            @foreach (var partner in Model)
                            {
                                <tr>
                                    <td>
                                        <div style="width: 80px; height: 50px; background: #f8fafc; border: 1px solid var(--border-color); border-radius: 6px; overflow: hidden; display: flex; align-items: center; justify-content: center; padding: 4px;">
                                            <img src="@partner.LogoUrl" alt="@partner.CompanyName" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                                        </div>
                                    </td>
                                    <td class="fw-bold text-dark logo-name">@partner.CompanyName</td>
                                    <td class="small"><a href="@partner.WebsiteUrl" target="_blank" class="text-decoration-none">@partner.WebsiteUrl</a></td>
                                    <td class="text-center font-monospace fw-bold text-primary">@partner.DisplayOrder</td>
                                    <td class="text-center">
                                        <div class="d-flex gap-2 justify-content-center flex-nowrap">
                                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3 edit-logo-btn"
                                                    data-id="@partner.Id"
                                                    data-name="@partner.CompanyName"
                                                    data-url="@partner.WebsiteUrl"
                                                    data-order="@partner.DisplayOrder"
                                                    data-active="@(partner.IsActive ? "true" : "false")">
                                                <i class="fa-solid fa-pen"></i> Sửa
                                            </button>
                                            <a asp-action="DeletePartnerLogo" asp-route-id="@partner.Id" class="btn btn-sm btn-outline-danger px-3 rounded-pill" data-confirm="Bạn có chắc chắn muốn xóa logo doanh nghiệp này?"><i class="fa-solid fa-trash-can me-1"></i> Xóa</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-building-slash fs-2 text-muted mb-3"></i>
                    <p class="text-muted m-0">Chưa có logo doanh nghiệp nào được tải lên chân trang.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- EDIT PARTNER LOGO MODAL -->
<div class="modal fade" id="editLogoModal" tabindex="-1" aria-labelledby="editLogoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold font-monospace" id="editLogoModalLabel"><i class="fa-solid fa-pen-to-square me-2"></i> CẬP NHẬT LOGO DOANH NGHIỆP</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditPartnerLogo" method="post" enctype="multipart/form-data">
                <input type="hidden" name="id" id="editLogoId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Tên Doanh nghiệp thành viên <span class="text-danger">*</span></label>
                        <input type="text" name="companyName" id="editLogoName" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Thay thế ảnh Logo mới (Để trống nếu giữ nguyên)</label>
                        <input type="file" name="logoFile" class="form-control" accept="image/*" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Liên kết Website của Doanh nghiệp</label>
                        <input type="url" name="websiteUrl" id="editLogoUrl" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Thứ tự hiển thị (Sắp xếp)</label>
                        <input type="number" name="displayOrder" id="editLogoOrder" class="form-control" required />
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" name="isActive" role="switch" id="editLogoActive" value="true" />
                        <label class="form-check-label fw-bold text-secondary" for="editLogoActive">Trạng thái kích hoạt hiển thị ở chân trang</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3 font-monospace btn-sm" data-bs-dismiss="modal">ĐÓNG</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 font-monospace btn-sm">CẬP NHẬT</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.edit-logo-btn').click(function() {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var url = $(this).data('url');
                var order = $(this).data('order');
                var active = $(this).data('active');

                $('#editLogoId').val(id);
                $('#editLogoName').val(name);
                $('#editLogoUrl').val(url);
                $('#editLogoOrder').val(order);

                if (active === true || active === 'true') {
                    $('#editLogoActive').prop('checked', true);
                } else {
                    $('#editLogoActive').prop('checked', false);
                }

                $('#editLogoModal').modal('show');
            });

            // Client-side Table Filter for Logos
            function filterLogosTable() {
                var searchVal = $('#logoSearchInput').val().toLowerCase().trim();
                var statusVal = $('#logoStatusFilter').val(); // "active" or "inactive" or ""

                $('#logosTableBody tr').each(function () {
                    var row = $(this);
                    if (row.attr('id') === 'noLogosRow') return;

                    var name = row.find('.logo-name').text().toLowerCase();
                    var activeAttr = row.find('.edit-logo-btn').attr('data-active');
                    var isActive = (activeAttr === 'true' || activeAttr === true);

                    // Check Search keyword
                    var matchesSearch = (name.indexOf(searchVal) > -1);

                    // Check Status Filter
                    var matchesStatus = true;
                    if (statusVal === "active") {
                        matchesStatus = isActive;
                    } else if (statusVal === "inactive") {
                        matchesStatus = !isActive;
                    }

                    if (matchesSearch && matchesStatus) {
                        row.show();
                    } else {
                        row.hide();
                    }
                });

                // Display "No results" if all rows are hidden
                if ($('#logosTableBody tr:visible').not('#noLogosRow').length === 0) {
                    if ($('#noLogosRow').length === 0) {
                        $('#logosTableBody').append('<tr id="noLogosRow"><td colspan="5" class="text-center text-muted py-4"><i class="fa-solid fa-folder-open fs-3 d-block mb-2"></i>Không tìm thấy logo doanh nghiệp phù hợp.</td></tr>');
                    }
                } else {
                    $('#noBannersRow').remove();
                    $('#noLogosRow').remove();
                }
            }

            $('#logoSearchInput').on('keyup', filterLogosTable);
            $('#logoStatusFilter').on('change', filterLogosTable);
        });
    </script>
}
