<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    
    <!-- CSS Bootstrap 5 & FontAwesome -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- MOBILE TOP BAR -->
    <div class="admin-top-nav-mobile d-none">
        <button class="btn btn-outline-primary border-0 btn-sm me-3" id="sidebarToggleBtn">
            <i class="fa-solid fa-bars fs-5"></i>
        </button>
        <span class="fw-bold text-dark font-monospace text-uppercase" style="font-size: 0.85rem;">HỆ THỐNG QUẢN TRỊ CMS</span>
    </div>

    <!-- SIDEBAR OVERLAY -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="admin-wrapper">
        <!-- SIDEBAR NAV -->
        <nav class="admin-sidebar shadow" id="adminSidebar">
            <div class="sidebar-header d-flex flex-column align-items-center text-center py-3" style="border-bottom: 1px solid #1e293b; background-color: rgba(0,0,0,0.15);">
                <img src="/uploads/logos/logo.png" alt="Logo" class="img-fluid mb-2" style="max-height: 75px; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));" />
                <span class="d-block text-white fw-bold" style="font-size: 0.68rem; line-height: 1.4; text-transform: uppercase; letter-spacing: 0.3px; max-width: 220px;">Viện phát triển bảo vệ thương hiệu và chống hàng giả</span>
            </div>
            <ul class="list-unstyled components">
                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-gauge me-3"></i>Tổng quannnn</a>
                </li>
                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Posts" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Posts"><i class="fa-solid fa-newspaper me-3"></i>Quản lý bài viết</a>
                </li>
                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Banners" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Banners"><i class="fa-solid fa-rectangle-ad me-3"></i>Quản lý Banners</a>
                </li>
                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Videos" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Videos"><i class="fa-solid fa-video me-3"></i>Quản lý Videos</a>
                </li>
                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "PartnerLogos" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="PartnerLogos"><i class="fa-solid fa-building me-3"></i>Quản lý Logos</a>
                </li>
                <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Categories" ? "active" : "")">
                    <a asp-controller="Admin" asp-action="Categories"><i class="fa-solid fa-tags me-3"></i>Quản lý Chuyên mục</a>
                </li>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <li class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")">
                        <a asp-controller="Admin" asp-action="Users"><i class="fa-solid fa-users-gear me-3"></i>Phân quyền tài khoản</a>
                    </li>
                }
                <hr class="mx-3 text-light-50" />
                <li>
                    <a href="http://localhost:5000" target="_blank"><i class="fa-solid fa-globe me-3"></i>Xem trang chủ</a>
                </li>
                <li>
                    <a asp-controller="Auth" asp-action="Logout" class="text-danger"><i class="fa-solid fa-right-from-bracket me-3"></i>Thoát hệ thống</a>
                </li>
            </ul>
        </nav>

        <!-- MAIN ADMIN CONTENT -->
        <div class="admin-content">
            <!-- TOP NAVBAR -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 pb-3 border-bottom gap-3">
                <h2 class="brand-font m-0 text-uppercase text-secondary">@ViewData["Title"]</h2>
                <div class="admin-user-info">
                    <span class="badge bg-light text-dark border p-2 font-monospace d-inline-block text-wrap text-start"><i class="fa-solid fa-user-tie text-primary me-2"></i> Quyền: @(User.IsInRole("SuperAdmin") ? "SuperAdmin" : "Editor") | Tài khoản: @User.Identity?.Name</span>
                </div>
            </div>

            <!-- MESSAGES -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#sidebarToggleBtn, #sidebarOverlay').click(function () {
                $('#adminSidebar').toggleClass('show');
                $('#sidebarOverlay').toggleClass('show');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
