@model List<New_folder.Models.Post>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Bài viết PR";
    var categories = ViewBag.Categories as List<New_folder.Models.Category> ?? new List<New_folder.Models.Category>();
}

<div class="row g-4 mb-4">
    <!-- COLLAPSIBLE FORM TO POST AN ARTICLE -->
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3 border-0">
                <h4 class="m-0 brand-font fs-5 text-white text-uppercase"><i class="fa-solid fa-pen-to-square me-2 text-warning"></i> Đăng bài viết PR mới</h4>
                <button class="btn btn-warning btn-sm text-dark fw-bold rounded-pill px-3" type="button" data-bs-toggle="collapse" data-bs-target="#createPostForm" aria-expanded="false" aria-controls="createPostForm">
                    <i class="fa-solid fa-plus me-1"></i> Soạn bài viết
                </button>
            </div>
            <div class="collapse" id="createPostForm">
                <div class="card-body p-4 bg-white border-top">
                    <form asp-action="CreatePost" method="post" enctype="multipart/form-data">
                        <div class="row g-3 mb-3">
                            <div class="col-md-8 col-12">
                                <label class="form-label fw-bold text-secondary">Tiêu đề bài viết <span class="text-danger">*</span></label>
                                <input type="text" name="title" class="form-control form-control-lg" placeholder="Nhập tiêu đề tin PR..." required />
                            </div>
                            <div class="col-md-4 col-12">
                                <label class="form-label fw-bold text-secondary">Chuyên mục <span class="text-danger">*</span></label>
                                <select name="categoryId" class="form-select form-select-lg" required>
                                    <option value="">-- Chọn chuyên mục --</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6 col-12">
                                <label class="form-label fw-bold text-secondary">Tác giả bài viết</label>
                                <input type="text" name="customAuthor" class="form-control" placeholder="Tên tác giả hiển thị..." />
                            </div>
                            <div class="col-md-6 col-12">
                                <label class="form-label fw-bold text-secondary">Doanh nghiệp liên quan</label>
                                <input type="text" name="customBusiness" class="form-control" placeholder="Tên doanh nghiệp..." />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4 col-12">
                                <label class="form-label fw-bold text-secondary">Ảnh đại diện bài viết (Cover Image)</label>
                                <input type="file" name="imageFile" class="form-control mb-2" accept="image/*" />
                                <input type="text" name="imageCaption" class="form-control form-control-sm" placeholder="Chú thích ảnh đại diện..." />
                            </div>
                            <div class="col-md-4 col-12">
                                <label class="form-label fw-bold text-secondary">Ảnh bổ sung (Có thể chọn nhiều)</label>
                                <input type="file" name="additionalImages" id="createAdditionalImages" class="form-control mb-2" accept="image/*" multiple />
                                <div id="createAdditionalCaptionsContainer" class="d-flex flex-column gap-2"></div>
                            </div>
                            <div class="col-md-4 col-12 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" role="switch" id="isFeatured" name="isFeatured" value="true">
                                    <label class="form-check-label fw-bold text-danger" for="isFeatured">Ghim bài viết lên tiêu điểm Slide trang chủ</label>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3 bg-light p-3 rounded border">
                            <div class="col-md-4 col-12">
                                <label class="form-label fw-bold text-secondary">Nguồn Video bài viết</label>
                                <select name="videoSource" id="createVideoSource" class="form-select">
                                    <option value="None">Không có video</option>
                                    <option value="YouTube">YouTube URL</option>
                                    <option value="Upload">Tải video lên (Tự động nén WebM)</option>
                                </select>
                            </div>
                            <div class="col-md-8 col-12" id="createYoutubeUrlContainer" style="display: none;">
                                <label class="form-label fw-bold text-secondary">Đường dẫn YouTube Video <span class="text-danger">*</span></label>
                                <input type="text" name="youtubeUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
                            </div>
                            <div class="col-md-8 col-12" id="createVideoFileContainer" style="display: none;">
                                <label class="form-label fw-bold text-secondary">Tệp Video <span class="text-danger">*</span></label>
                                <input type="file" name="videoFile" class="form-control" accept="video/*" />
                                <span class="text-muted small"><i class="fa-solid fa-circle-info"></i> Hệ thống tự động tối ưu hóa tệp tin video của bạn.</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Tóm tắt ngắn (Sapo)</label>
                            <textarea name="summary" class="form-control" rows="2" placeholder="Nhập tóm tắt mô tả ngắn gọn bài viết PR..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Nội dung chi tiết bài viết (Hỗ trợ định dạng Rich Text) <span class="text-danger">*</span></label>
                            <textarea name="content" id="createPostContent" class="form-control" rows="10" placeholder="Soạn nội dung chi tiết bài viết..."></textarea>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-toggle="collapse" data-bs-target="#createPostForm">Hủy bỏ</button>
                            <button type="submit" class="btn btn-primary rounded-3 px-4"><i class="fa-solid fa-paper-plane me-2"></i> Xuất bản bài viết</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- POSTS LISTING TABLE -->
<div class="row">
    <div class="col-12">
        <div class="admin-card">
            <h4 class="brand-font fs-5 text-secondary text-uppercase mb-4"><i class="fa-solid fa-newspaper me-2 text-warning"></i> Danh sách tất cả bài viết PR</h4>
            
            <!-- SEARCH AND FILTER CONTROLS -->
            <div class="row g-3 mb-4 p-3 bg-light rounded-3 border">
                <div class="col-md-5 col-12">
                    <label class="form-label fw-bold text-secondary small"><i class="fa-solid fa-magnifying-glass me-1"></i>Tìm kiếm từ khóa</label>
                    <input type="text" id="postSearchInput" class="form-control shadow-sm" placeholder="Tìm theo tiêu đề, tác giả, doanh nghiệp..." />
                </div>
                <div class="col-md-3 col-6">
                    <label class="form-label fw-bold text-secondary small"><i class="fa-solid fa-tags me-1"></i>Chuyên mục</label>
                    <select id="postCategoryFilter" class="form-select shadow-sm">
                        <option value="">Tất cả chuyên mục</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Name">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 col-6">
                    <label class="form-label fw-bold text-secondary small"><i class="fa-solid fa-circle-check me-1"></i>Trạng thái duyệt</label>
                    <select id="postStatusFilter" class="form-select shadow-sm">
                        <option value="">Tất cả trạng thái</option>
                        <option value="approved">Đã duyệt (Kích hoạt)</option>
                        <option value="pending">Chưa duyệt (Tắt)</option>
                    </select>
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr class="table-light">
                                <th>Ảnh bìa</th>
                                <th>Tiêu đề</th>
                                <th>Chuyên mục</th>
                                <th>Tác giả / Doanh nghiệp</th>
                                <th>Ngày đăng</th>
                                <th class="text-center">Được duyệt</th>
                                <th class="text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="postsTableBody">
                            @foreach (var post in Model)
                            {
                                <tr>
                                    <td>
                                        <div style="width: 80px; height: 50px; overflow: hidden; border-radius: 6px; border: 1px solid var(--border-color);">
                                            <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=80&w=200" : post.ImageUrl)" class="w-100 h-100" style="object-fit: cover;" alt="" />
                                        </div>
                                    </td>
                                    <td>
                                        <h6 class="m-0 fw-bold post-title">@post.Title</h6>
                                        @if (post.IsFeatured)
                                        {
                                            <span class="badge bg-danger font-monospace text-uppercase" style="font-size: 0.6rem;"><i class="fa-solid fa-thumbtack me-1"></i> Tiêu điểm</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-light text-secondary post-category">@post.Category?.Name</span></td>
                                    <td class="small post-author">
                                        <div>@(string.IsNullOrEmpty(post.CustomAuthor) ? post.Author?.FullName : post.CustomAuthor)</div>
                                        <div class="text-muted">@(string.IsNullOrEmpty(post.CustomBusiness) ? post.Author?.CompanyName : post.CustomBusiness)</div>
                                    </td>
                                    <td class="small text-muted font-monospace">@post.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input post-approval-checkbox" type="checkbox" role="switch" checked="@post.IsApproved" onchange="togglePostApproval(@post.Id)" />
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex gap-2 justify-content-center align-items-center flex-nowrap">
                                            <button type="button" class="btn btn-sm btn-outline-primary px-3 rounded-pill btn-edit-post"
                                                    data-id="@post.Id"
                                                    data-title="@post.Title"
                                                    data-categoryid="@post.CategoryId"
                                                    data-featured="@post.IsFeatured.ToString().ToLower()"
                                                    data-isapproved="@post.IsApproved.ToString().ToLower()"
                                                    data-videotype="@post.VideoType"
                                                    data-videourl="@post.VideoUrl"
                                                    data-customauthor="@post.CustomAuthor"
                                                    data-custombusiness="@post.CustomBusiness"
                                                    data-imagecaption="@post.ImageCaption">
                                                <i class="fa-solid fa-pen-to-square me-1"></i> Sửa
                                            </button>
                                            <a asp-action="DeletePost" asp-route-id="@post.Id" class="btn btn-sm btn-outline-danger px-3 rounded-pill" data-confirm="Bạn có chắc chắn muốn xóa bài viết này?"><i class="fa-solid fa-trash-can me-1"></i> Xóa</a>
                                        </div>
                                        
                                        <textarea class="d-none" id="summary-@post.Id">@post.Summary</textarea>
                                        <textarea class="d-none" id="content-@post.Id">@post.Content</textarea>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-newspaper fs-2 text-muted mb-3"></i>
                    <p class="text-muted m-0">Chưa có bài viết PR nào được đăng tải trên hệ thống.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- EDIT POST MODAL -->
<div class="modal fade" id="editPostModal" tabindex="-1" aria-labelledby="editPostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold text-white text-uppercase" id="editPostModalLabel"><i class="fa-solid fa-pen-to-square me-2 text-warning"></i> Cập nhật Bài viết PR</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditPost" method="post" enctype="multipart/form-data">
                <input type="hidden" name="id" id="editPostId" />
                <div class="modal-body p-4 bg-light">
                    <div class="row g-3 mb-3">
                        <div class="col-md-8 col-12">
                            <label class="form-label fw-bold text-secondary">Tiêu đề bài viết <span class="text-danger">*</span></label>
                            <input type="text" name="title" id="editPostTitle" class="form-control form-control-lg shadow-sm" required />
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label fw-bold text-secondary">Chuyên mục <span class="text-danger">*</span></label>
                            <select name="categoryId" id="editPostCategoryId" class="form-select form-select-lg shadow-sm" required>
                                <option value="">-- Chọn chuyên mục --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-bold text-secondary">Tác giả bài viết</label>
                            <input type="text" name="customAuthor" id="editPostCustomAuthor" class="form-control shadow-sm" placeholder="Tên tác giả hiển thị..." />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-bold text-secondary">Doanh nghiệp liên quan</label>
                            <input type="text" name="customBusiness" id="editPostCustomBusiness" class="form-control shadow-sm" placeholder="Tên doanh nghiệp..." />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4 col-12">
                            <label class="form-label fw-bold text-secondary">Thay đổi ảnh đại diện (Để trống để giữ nguyên)</label>
                            <input type="file" name="imageFile" class="form-control shadow-sm mb-2" accept="image/*" />
                            <input type="text" name="imageCaption" id="editPostImageCaption" class="form-control form-control-sm shadow-sm" placeholder="Chú thích ảnh đại diện..." />
                        </div>
                        <div class="col-md-4 col-12">
                            <label class="form-label fw-bold text-secondary">Thêm ảnh bổ sung (Sẽ thay thế ảnh bổ sung cũ)</label>
                            <input type="file" name="additionalImages" id="editAdditionalImages" class="form-control shadow-sm mb-2" accept="image/*" multiple />
                            <div id="editAdditionalCaptionsContainer" class="d-flex flex-column gap-2"></div>
                        </div>
                        <div class="col-md-4 col-12 d-flex align-items-center">
                            <div class="d-flex gap-3 mt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="editPostFeatured" name="isFeatured" value="true">
                                    <label class="form-check-label fw-bold text-danger" for="editPostFeatured">Ghim Slide</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="editPostApproved" name="isApproved" value="true">
                                    <label class="form-check-label fw-bold text-success" for="editPostApproved">Duyệt hiển thị</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3 bg-white p-3 rounded border shadow-sm">
                        <div class="col-md-4 col-12">
                            <label class="form-label fw-bold text-secondary">Cấu hình Video bài viết</label>
                            <select name="videoSource" id="editVideoSource" class="form-select">
                                <option value="None">Không có video</option>
                                <option value="YouTube">YouTube URL</option>
                                <option value="Upload">Tải video mới lên</option>
                            </select>
                        </div>
                        <div class="col-md-8 col-12" id="editYoutubeUrlContainer" style="display: none;">
                            <label class="form-label fw-bold text-secondary">Đường dẫn YouTube Video <span class="text-danger">*</span></label>
                            <input type="text" name="youtubeUrl" id="editYoutubeUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
                        </div>
                        <div class="col-md-8 col-12" id="editVideoFileContainer" style="display: none;">
                            <label class="form-label fw-bold text-secondary">Tải lên video mới <span class="text-danger">*</span></label>
                            <input type="file" name="videoFile" class="form-control" accept="video/*" />
                            <span class="text-muted small"><i class="fa-solid fa-circle-info"></i> Hệ thống tự động tối ưu hóa tệp tin video của bạn.</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Tóm tắt ngắn (Sapo)</label>
                        <textarea name="summary" id="editPostSummary" class="form-control shadow-sm" rows="3" placeholder="Nhập tóm tắt mô tả ngắn gọn..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary">Nội dung chi tiết bài viết (Hỗ trợ định dạng HTML) <span class="text-danger">*</span></label>
                        <textarea name="content" id="editPostContent" class="form-control shadow-sm" rows="12" placeholder="Soạn nội dung chi tiết..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4"><i class="fa-solid fa-save me-2"></i> Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/36.0.1/classic/ckeditor.js"></script>
    <script>
        function togglePostApproval(id) {
            $.post("/Admin/ApprovePost/" + id);
        }

        // Custom Upload Adapter for CKEditor 5 (highly compatible with standard CDN build)
        class MyUploadAdapter {
            constructor(loader) {
                this.loader = loader;
            }

            upload() {
                return this.loader.file
                    .then(file => new Promise((resolve, reject) => {
                        this._initRequest();
                        this._initListeners(resolve, reject, file);
                        this._sendRequest(file);
                    }));
            }

            abort() {
                if (this.xhr) {
                    this.xhr.abort();
                }
            }

            _initRequest() {
                const xhr = this.xhr = new XMLHttpRequest();
                xhr.open('POST', '/Admin/UploadEditorImage', true);
                xhr.responseType = 'json';
            }

            _initListeners(resolve, reject, file) {
                const xhr = this.xhr;
                const loader = this.loader;
                const genericErrorText = `Không thể tải tệp tin lên: ${file.name}.`;

                xhr.addEventListener('error', () => reject(genericErrorText));
                xhr.addEventListener('abort', () => reject());
                xhr.addEventListener('load', () => {
                    const response = xhr.response;

                    if (!response || response.error) {
                        return reject(response && response.error ? response.error.message : genericErrorText);
                    }

                    // CKEditor 5 expects { default: "IMAGE_URL" }
                    resolve({
                        default: response.url
                    });
                });

                if (xhr.upload) {
                    xhr.upload.addEventListener('progress', evt => {
                        if (evt.lengthComputable) {
                            loader.uploadTotal = evt.total;
                            loader.uploaded = evt.loaded;
                        }
                    });
                }
            }

            _sendRequest(file) {
                const data = new FormData();
                data.append('upload', file);
                this.xhr.send(data);
            }
        }

        function MyCustomUploadAdapterPlugin(editor) {
            editor.plugins.get('FileRepository').createUploadAdapter = (loader) => {
                return new MyUploadAdapter(loader);
            };
        }

        let createEditor;
        let editEditor;

        // Initialize CKEditor 5 for Create Form
        ClassicEditor
            .create(document.querySelector('#createPostContent'), {
                placeholder: 'Soạn nội dung chi tiết bài viết tại đây...',
                extraPlugins: [ MyCustomUploadAdapterPlugin ]
            })
            .then(editor => {
                createEditor = editor;
            })
            .catch(error => {
                console.error(error);
            });

        // Initialize CKEditor 5 for Edit Modal
        ClassicEditor
            .create(document.querySelector('#editPostContent'), {
                placeholder: 'Cập nhật nội dung chi tiết bài viết tại đây...',
                extraPlugins: [ MyCustomUploadAdapterPlugin ]
            })
            .then(editor => {
                editEditor = editor;
            })
            .catch(error => {
                console.error(error);
            });

        $(document).ready(function() {
            // Toggle video source inputs in Create Form
            $('#createVideoSource').change(function() {
                var source = $(this).val();
                if (source === 'YouTube') {
                    $('#createYoutubeUrlContainer').show();
                    $('#createVideoFileContainer').hide();
                } else if (source === 'Upload') {
                    $('#createYoutubeUrlContainer').hide();
                    $('#createVideoFileContainer').show();
                } else {
                    $('#createYoutubeUrlContainer').hide();
                    $('#createVideoFileContainer').hide();
                }
            });

            // Toggle video source inputs in Edit Form
            $('#editVideoSource').change(function() {
                var source = $(this).val();
                if (source === 'YouTube') {
                    $('#editYoutubeUrlContainer').show();
                    $('#editVideoFileContainer').hide();
                } else if (source === 'Upload') {
                    $('#editYoutubeUrlContainer').hide();
                    $('#editVideoFileContainer').show();
                } else {
                    $('#editYoutubeUrlContainer').hide();
                    $('#editVideoFileContainer').hide();
                }
            });

            // Dynamically generate captions textboxes for additional images in Create form
            $('#createAdditionalImages').change(function() {
                var files = this.files;
                var container = $('#createAdditionalCaptionsContainer');
                container.empty();
                for (var i = 0; i < files.length; i++) {
                    var fileName = files[i].name;
                    container.append(
                        '<div class="input-group input-group-sm mb-1">' +
                        '<span class="input-group-text bg-light text-truncate" style="max-width: 150px;" title="' + fileName + '">' + fileName + '</span>' +
                        '<input type="text" name="additionalCaptions" class="form-control" placeholder="Chú thích ảnh..." />' +
                        '</div>'
                    );
                }
            });

            // Dynamically generate captions textboxes for additional images in Edit form
            $('#editAdditionalImages').change(function() {
                var files = this.files;
                var container = $('#editAdditionalCaptionsContainer');
                container.empty();
                for (var i = 0; i < files.length; i++) {
                    var fileName = files[i].name;
                    container.append(
                        '<div class="input-group input-group-sm mb-1">' +
                        '<span class="input-group-text bg-light text-truncate" style="max-width: 150px;" title="' + fileName + '">' + fileName + '</span>' +
                        '<input type="text" name="additionalCaptions" class="form-control" placeholder="Chú thích ảnh..." />' +
                        '</div>'
                    );
                }
            });

            $('.btn-edit-post').click(function() {
                var id = $(this).data('id');
                var title = $(this).data('title');
                var categoryid = $(this).data('categoryid');
                var featured = $(this).data('featured');
                var approved = $(this).data('isapproved');
                var videoType = $(this).data('videotype') || 'None';
                var videoUrl = $(this).data('videourl') || '';
                var customAuthor = $(this).data('customauthor') || '';
                var customBusiness = $(this).data('custombusiness') || '';
                var imageCaption = $(this).data('imagecaption') || '';

                var summary = $('#summary-' + id).val();
                var content = $('#content-' + id).val();

                $('#editPostId').val(id);
                $('#editPostTitle').val(title);
                $('#editPostCategoryId').val(categoryid);
                
                $('#editPostFeatured').prop('checked', featured === true || featured === 'true');
                $('#editPostApproved').prop('checked', approved === true || approved === 'true');

                $('#editPostCustomAuthor').val(customAuthor);
                $('#editPostCustomBusiness').val(customBusiness);
                $('#editPostImageCaption').val(imageCaption);
                $('#editAdditionalCaptionsContainer').empty(); // Clear old input lists when opening a new edit

                // Pre-populate video configuration
                $('#editVideoSource').val(videoType);
                if (videoType === 'YouTube') {
                    $('#editYoutubeUrlContainer').show();
                    $('#editVideoFileContainer').hide();
                    $('#editYoutubeUrl').val(videoUrl);
                } else if (videoType === 'Local') {
                    $('#editYoutubeUrlContainer').hide();
                    $('#editVideoFileContainer').show();
                    $('#editYoutubeUrl').val('');
                } else {
                    $('#editYoutubeUrlContainer').hide();
                    $('#editVideoFileContainer').hide();
                    $('#editYoutubeUrl').val('');
                }

                $('#editPostSummary').val(summary);
                
                // Set data to CKEditor
                if (editEditor) {
                    editEditor.setData(content);
                } else {
                    $('#editPostContent').val(content);
                }

                $('#editPostModal').modal('show');
            });

            // Ensure CKEditor data is fully synced to underlying textarea before form submit & validate empty contents
            $('form').on('submit', function(e) {
                // Validate Create Form
                if ($(this).find('#createPostContent').length > 0) {
                    if (createEditor) {
                        var data = createEditor.getData().trim();
                        $('#createPostContent').val(data);
                        
                        var plainText = $('<div>').html(data).text().trim();
                        if (plainText === '' && data.indexOf('<img') === -1) {
                            alert('Vui lòng soạn nội dung chi tiết bài viết!');
                            e.preventDefault();
                            return false;
                        }
                    }
                }
                
                // Validate Edit Form
                if ($(this).find('#editPostContent').length > 0) {
                    if (editEditor) {
                        var data = editEditor.getData().trim();
                        $('#editPostContent').val(data);
                        
                        var plainText = $('<div>').html(data).text().trim();
                        if (plainText === '' && data.indexOf('<img') === -1) {
                            alert('Vui lòng soạn nội dung chi tiết bài viết!');
                            e.preventDefault();
                            return false;
                        }
                    }
                }
            });

            // Client-side Table Filter for Posts
            function filterPostsTable() {
                var searchVal = $('#postSearchInput').val().toLowerCase().trim();
                var catVal = $('#postCategoryFilter').val().toLowerCase().trim();
                var statusVal = $('#postStatusFilter').val(); // "approved" or "pending" or ""

                $('#postsTableBody tr').each(function () {
                    var row = $(this);
                    // Skip if it's the no-results row
                    if (row.attr('id') === 'noPostsRow') return;

                    var title = row.find('.post-title').text().toLowerCase();
                    var category = row.find('.post-category').text().toLowerCase();
                    var author = row.find('.post-author').text().toLowerCase();
                    var isApproved = row.find('.post-approval-checkbox').is(':checked');

                    // Check Search keyword (in title, author or business)
                    var matchesSearch = (title.indexOf(searchVal) > -1 || author.indexOf(searchVal) > -1);
                    
                    // Check Category Filter
                    var matchesCategory = (catVal === "" || category.indexOf(catVal) > -1);

                    // Check Status Filter
                    var matchesStatus = true;
                    if (statusVal === "approved") {
                        matchesStatus = isApproved;
                    } else if (statusVal === "pending") {
                        matchesStatus = !isApproved;
                    }

                    if (matchesSearch && matchesCategory && matchesStatus) {
                        row.show();
                    } else {
                        row.hide();
                    }
                });

                // Display "No results" if all rows are hidden
                if ($('#postsTableBody tr:visible').not('#noPostsRow').length === 0) {
                    if ($('#noPostsRow').length === 0) {
                        $('#postsTableBody').append('<tr id="noPostsRow"><td colspan="7" class="text-center text-muted py-4"><i class="fa-solid fa-folder-open fs-3 d-block mb-2"></i>Không tìm thấy bài viết phù hợp.</td></tr>');
                    }
                } else {
                    $('#noPostsRow').remove();
                }
            }

            $('#postSearchInput').on('keyup', filterPostsTable);
            $('#postCategoryFilter, #postStatusFilter').on('change', filterPostsTable);
        });
    </script>
}
