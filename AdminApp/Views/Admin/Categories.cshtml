@model IEnumerable<New_folder.Models.Category>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Chuyên mục";
}

<div class="card shadow-sm border border-light-subtle rounded-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="m-0 fw-bold brand-font text-primary"><i class="fa-solid fa-tags me-2"></i> DANH SÁCH CHUYÊN MỤC</h5>
        <button class="btn btn-primary btn-sm rounded-pill px-3 font-monospace fw-bold" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="fa-solid fa-plus me-1"></i> THÊM MỚI
        </button>
    </div>
    <div class="card-body p-0">
        <!-- SEARCH AND FILTER CONTROLS -->
        <div class="row g-3 p-3 bg-light border-bottom m-0">
            <div class="col-md-7 col-12">
                <label class="form-label fw-bold text-secondary small"><i class="fa-solid fa-magnifying-glass me-1"></i>Tìm kiếm</label>
                <input type="text" id="categorySearchInput" class="form-control shadow-sm" placeholder="Tìm theo tên chuyên mục, slug..." />
            </div>
            <div class="col-md-5 col-12">
                <label class="form-label fw-bold text-secondary small"><i class="fa-solid fa-circle-check me-1"></i>Hiển thị Navbar</label>
                <select id="categoryNavFilter" class="form-select shadow-sm">
                    <option value="">Tất cả</option>
                    <option value="shown">Có hiển thị</option>
                    <option value="hidden">Không hiển thị (Tắt)</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light font-monospace text-uppercase text-secondary" style="font-size: 0.85rem;">
                    <tr>
                        <th class="ps-4" style="width: 80px;">ID</th>
                        <th>Tên chuyên mục</th>
                        <th>Slug</th>
                        <th>Bố cục</th>
                        <th class="text-center" style="width: 150px;">Thứ tự hiển thị</th>
                        <th class="text-center" style="width: 180px;">Hiển thị Navbar</th>
                        <th class="text-end pe-4" style="width: 180px;">Hành động</th>
                    </tr>
                </thead>
                <tbody id="categoriesTableBody">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 font-monospace fw-bold">#@item.Id</td>
                            <td class="fw-bold category-name">@item.Name</td>
                            <td class="text-secondary font-monospace category-slug">@item.Slug</td>
                            <td>
                                @if (item.DisplayLayout == "Standard") { <span class="badge bg-secondary">Tiêu chuẩn</span> }
                                else if (item.DisplayLayout == "Grid") { <span class="badge bg-info text-dark">Lưới ô</span> }
                                else if (item.DisplayLayout == "List") { <span class="badge bg-success">Danh sách</span> }
                                else if (item.DisplayLayout == "FeaturedOnly") { <span class="badge bg-warning text-dark">Tiêu điểm</span> }
                                else { <span class="badge bg-secondary">@item.DisplayLayout</span> }
                            </td>
                            <td class="text-center font-monospace">@item.DisplayOrder</td>
                            <td class="text-center">
                                <div class="form-check form-switch d-inline-block">
                                    <input class="form-check-input toggle-nav-switch category-nav-checkbox" type="checkbox" role="switch" data-id="@item.Id" @(item.IsShownOnNav ? "checked" : "") />
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-2 justify-content-end align-items-center flex-nowrap">
                                    <button class="btn btn-outline-primary btn-sm rounded-circle edit-category-btn" 
                                            data-id="@item.Id" 
                                            data-name="@item.Name" 
                                            data-order="@item.DisplayOrder" 
                                            data-nav="@(item.IsShownOnNav ? "true" : "false")"
                                            data-layout="@item.DisplayLayout"
                                            title="Chỉnh sửa">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <a asp-action="DeleteCategory" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-circle" data-confirm="Bạn có chắc chắn muốn xóa chuyên mục này? Các bài viết thuộc chuyên mục này phải được chuyển sang danh mục khác trước khi xóa." title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CREATE CATEGORY MODAL -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold font-monospace" id="createCategoryModalLabel"><i class="fa-solid fa-plus me-2"></i> THÊM CHUYÊN MỤC MỚI</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateCategory" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label font-monospace small text-secondary">Tên chuyên mục (*)</label>
                        <input type="text" name="name" class="form-control" placeholder="Ví dụ: Góc nhìn Doanh nghiệp" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-monospace small text-secondary">Bố cục hiển thị chuyên mục</label>
                        <select name="displayLayout" class="form-select">
                            <option value="Standard">Báo chí (Tiêu chuẩn)</option>
                            <option value="Grid">Lưới ô (3 cột)</option>
                            <option value="List">Danh sách dọc</option>
                            <option value="FeaturedOnly">Tiêu điểm nổi bật</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-monospace small text-secondary">Thứ tự hiển thị (Số nhỏ xếp trước)</label>
                        <input type="number" name="displayOrder" class="form-control" value="0" />
                    </div>
                    <div class="form-check form-switch mb-2 mt-3">
                        <input class="form-check-input" type="checkbox" name="isShownOnNav" role="switch" id="createIsShownOnNav" value="true" checked />
                        <label class="form-check-label font-monospace small text-secondary" for="createIsShownOnNav">Hiển thị trên thanh Navbar chính</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3 font-monospace btn-sm" data-bs-dismiss="modal">ĐÓNG</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 font-monospace btn-sm">LƯU LẠI</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT CATEGORY MODAL -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold font-monospace" id="editCategoryModalLabel"><i class="fa-solid fa-pen-to-square me-2"></i> CẬP NHẬT CHUYÊN MỤC</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditCategory" method="post">
                <input type="hidden" name="id" id="editCategoryId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label font-monospace small text-secondary">Tên chuyên mục (*)</label>
                        <input type="text" name="name" id="editCategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-monospace small text-secondary">Bố cục hiển thị chuyên mục</label>
                        <select name="displayLayout" id="editCategoryLayout" class="form-select">
                            <option value="Standard">Báo chí (Tiêu chuẩn)</option>
                            <option value="Grid">Lưới ô (3 cột)</option>
                            <option value="List">Danh sách dọc</option>
                            <option value="FeaturedOnly">Tiêu điểm nổi bật</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-monospace small text-secondary">Thứ tự hiển thị (Số nhỏ xếp trước)</label>
                        <input type="number" name="displayOrder" id="editCategoryOrder" class="form-control" />
                    </div>
                    <div class="form-check form-switch mb-2 mt-3">
                        <input class="form-check-input" type="checkbox" name="isShownOnNav" role="switch" id="editCategoryNav" value="true" />
                        <label class="form-check-label font-monospace small text-secondary" for="editCategoryNav">Hiển thị trên thanh Navbar chính</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-3 font-monospace btn-sm" data-bs-dismiss="modal">ĐÓNG</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 font-monospace btn-sm">CẬP NHẬT</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Fill edit modal dynamically
            $('.edit-category-btn').click(function() {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var order = $(this).data('order');
                var nav = $(this).data('nav');
                var layout = $(this).data('layout');
                
                $('#editCategoryId').val(id);
                $('#editCategoryName').val(name);
                $('#editCategoryOrder').val(order);
                $('#editCategoryLayout').val(layout || 'Standard');
                
                if (nav === true || nav === 'true') {
                    $('#editCategoryNav').prop('checked', true);
                } else {
                    $('#editCategoryNav').prop('checked', false);
                }
                
                $('#editCategoryModal').modal('show');
            });

            // Handle AJAX Toggle Nav switch
            $('.toggle-nav-switch').change(function() {
                var categoryId = $(this).data('id');
                var switchElem = $(this);
                
                $.ajax({
                    url: '/Admin/ToggleCategoryNav',
                    type: 'POST',
                    data: { id: categoryId },
                    success: function(response) {
                        if (response.success) {
                            console.log('Nav visibility updated successfully to: ' + response.isShownOnNav);
                        } else {
                            alert('Lỗi: ' + response.message);
                            // Revert state
                            switchElem.prop('checked', !switchElem.prop('checked'));
                        }
                    },
                    error: function() {
                        alert('Đã xảy ra lỗi hệ thống khi kết nối đến máy chủ.');
                        switchElem.prop('checked', !switchElem.prop('checked'));
                    }
                });
            });

            // Client-side Table Filter for Categories
            function filterCategoriesTable() {
                var searchVal = $('#categorySearchInput').val().toLowerCase().trim();
                var navVal = $('#categoryNavFilter').val(); // "shown" or "hidden" or ""

                $('#categoriesTableBody tr').each(function () {
                    var row = $(this);
                    if (row.attr('id') === 'noCategoriesRow') return;

                    var name = row.find('.category-name').text().toLowerCase();
                    var slug = row.find('.category-slug').text().toLowerCase();
                    var isShownOnNav = row.find('.category-nav-checkbox').is(':checked');

                    // Check Search keyword
                    var matchesSearch = (name.indexOf(searchVal) > -1 || slug.indexOf(searchVal) > -1);

                    // Check Nav Filter
                    var matchesNav = true;
                    if (navVal === "shown") {
                        matchesNav = isShownOnNav;
                    } else if (navVal === "hidden") {
                        matchesNav = !isShownOnNav;
                    }

                    if (matchesSearch && matchesNav) {
                        row.show();
                    } else {
                        row.hide();
                    }
                });

                // Display "No results" if all rows are hidden
                if ($('#categoriesTableBody tr:visible').not('#noCategoriesRow').length === 0) {
                    if ($('#noCategoriesRow').length === 0) {
                        $('#categoriesTableBody').append('<tr id="noCategoriesRow"><td colspan="7" class="text-center text-muted py-4"><i class="fa-solid fa-folder-open fs-3 d-block mb-2"></i>Không tìm thấy chuyên mục phù hợp.</td></tr>');
                    }
                } else {
                    $('#noCategoriesRow').remove();
                }
            }

            $('#categorySearchInput').on('keyup', filterCategoriesTable);
            $('#categoryNavFilter').on('change', filterCategoriesTable);
        });
    </script>
}
