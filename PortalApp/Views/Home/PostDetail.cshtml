@model New_folder.Models.Post

<style>
    /* Styling for premium inline images and captions in article body */
    .article-content figure.image {
        margin: 1.8rem auto;
        text-align: center;
        max-width: 100%;
        display: block;
    }
    .article-content figure.image img {
        max-width: 100%;
        max-height: 450px; /* Constrain extremely tall/large inline images */
        width: auto;
        height: auto;
        object-fit: contain; /* Prevent scaling distortion */
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        margin: 0 auto;
    }
    .article-content figure.image figcaption {
        font-size: 0.85rem;
        font-style: italic;
        color: #64748b;
        margin-top: 0.6rem;
        padding: 0.3rem 1.2rem;
        background-color: #f8fafc;
        border-radius: 6px;
        display: inline-block;
        border: 1px dashed #e2e8f0;
        max-width: 90%;
        text-align: center;
    }

    /* Related Images Carousel premium customization & responsive sizing */
    #relatedImagesCarousel {
        background-color: #0f172a;
        max-width: 600px; /* Centered, elegant maximum width for the image frame */
        margin: 0 auto;
    }
    #relatedImagesCarousel .carousel-inner {
        height: 350px; /* Elegant height on desktop */
    }
    @@media (max-width: 768px) {
        #relatedImagesCarousel .carousel-inner {
            height: 240px; /* Very compact and readable height on mobile screens */
        }
    }
    #relatedImagesCarousel .carousel-indicators [data-bs-target] {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin: 0 5px;
        background-color: rgba(255, 255, 255, 0.4);
        border: 1.5px solid rgba(0, 0, 0, 0.25);
        transition: all 0.25s ease;
    }
    #relatedImagesCarousel .carousel-indicators .active {
        background-color: #ffc107; /* Warning yellow matching theme */
        transform: scale(1.3);
        box-shadow: 0 0 8px rgba(255, 193, 7, 0.8);
    }
    #relatedImagesCarousel .carousel-control-prev-icon,
    #relatedImagesCarousel .carousel-control-next-icon {
        transition: transform 0.2s ease;
    }
    #relatedImagesCarousel .carousel-control-prev:hover .carousel-control-prev-icon,
    #relatedImagesCarousel .carousel-control-next:hover .carousel-control-next-icon {
        transform: scale(1.15);
    }
</style>

@{
    ViewData["Title"] = Model.Title;
    var relatedPosts = ViewBag.RelatedPosts as List<New_folder.Models.Post> ?? new List<New_folder.Models.Post>();
    var latestPosts = ViewBag.LatestPosts as List<New_folder.Models.Post> ?? new List<New_folder.Models.Post>();
    var sidebarBanners = ViewBag.SidebarBanners as List<New_folder.Models.Banner> ?? new List<New_folder.Models.Banner>();

    List<System.Text.Json.JsonElement> additionalImages = new List<System.Text.Json.JsonElement>();
    if (!string.IsNullOrEmpty(Model.AdditionalImages))
    {
        try
        {
            additionalImages = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(Model.AdditionalImages) ?? new List<System.Text.Json.JsonElement>();
        }
        catch {}
    }
}

<!-- BREADCRUMB -->
<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-premium">
                <li class="breadcrumb-item"><a asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="Category" asp-route-slug="@Model.Category?.Slug">@Model.Category?.Name</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết bài viết</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row g-4">
    <!-- LEFT: ARTICLE FULL READ (70%) -->
    <div class="col-lg-8">
        <article class="bg-white border rounded-3 p-4 p-md-5 shadow-sm">
            <header class="mb-4 pb-4 border-bottom">
                <span class="badge bg-danger text-uppercase font-monospace mb-2">@Model.Category?.Name</span>
                <h1 class="brand-font fs-2 text-dark lh-base">@Model.Title</h1>
                <div class="d-flex align-items-center text-muted small mt-3 flex-wrap gap-3">
                    <span><i class="fa-regular fa-clock me-1"></i> Đăng lúc: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    @if (!string.IsNullOrEmpty(Model.CustomAuthor))
                    {
                        <span><i class="fa-regular fa-user me-1"></i> Tác giả: <strong>@Model.CustomAuthor</strong></span>
                    }
                    @if (!string.IsNullOrEmpty(Model.CustomBusiness))
                    {
                        <span><i class="fa-solid fa-building me-1"></i> Doanh nghiệp: <strong>@Model.CustomBusiness</strong></span>
                    }
                </div>
            </header>

            @if (!string.IsNullOrEmpty(Model.Summary))
            {
                <div class="p-3 bg-light border-start border-danger border-4 rounded-end-3 mb-4 fw-bold text-secondary">
                    @Model.Summary
                </div>
            }

            @if (Model.VideoType == "YouTube" && !string.IsNullOrEmpty(Model.VideoUrl))
            {
                <!-- Handle YouTube Video Embed -->
                var youtubeUrl = Model.VideoUrl;
                var embedUrl = youtubeUrl;
                if (youtubeUrl.Contains("watch?v="))
                {
                    var parts = youtubeUrl.Split("v=");
                    if (parts.Length > 1)
                    {
                        var id = parts[1].Split("&")[0];
                        embedUrl = $"https://www.youtube.com/embed/{id}";
                    }
                }
                else if (youtubeUrl.Contains("youtu.be/"))
                {
                    var parts = youtubeUrl.Split("youtu.be/");
                    if (parts.Length > 1)
                    {
                        var id = parts[1].Split("?")[0];
                        embedUrl = $"https://www.youtube.com/embed/{id}";
                    }
                }

                <div class="ratio ratio-16x9 mb-4 overflow-hidden rounded-3 shadow-sm border">
                    <iframe src="@embedUrl" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                </div>
            }
            else if (Model.VideoType == "Local" && !string.IsNullOrEmpty(Model.VideoUrl))
            {
                <!-- Handle Local Video Player -->
                <div class="mb-4 overflow-hidden rounded-3 shadow-sm border bg-black">
                    <video class="w-100" style="max-height: 500px;" controls preload="metadata" poster="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : Model.ImageUrl)">
                        <source src="@Model.VideoUrl" type="@(Model.VideoUrl.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) ? "video/webm" : "video/mp4")">
                        Trình duyệt của bạn không hỗ trợ thẻ phát video HTML5.
                    </video>
                </div>
            }
            else if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="text-center mb-4 overflow-hidden rounded-3 border">
                    <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid w-100" style="max-height: 450px; object-fit: cover;" />
                    @if (!string.IsNullOrEmpty(Model.ImageCaption))
                    {
                        <div class="py-2 px-3 bg-light text-center border-top text-muted small fst-italic">
                            @Model.ImageCaption
                        </div>
                    }
                </div>
            }

            <div class="article-content text-dark fs-6 lh-lg mb-5" style="text-align: justify; word-break: break-word;">
                @Html.Raw(Model.Content)
            </div>

            @if (additionalImages != null && additionalImages.Any())
            {
                <div class="mb-4 pt-4 border-top">
                    <h5 class="brand-font text-secondary text-uppercase mb-3"><i class="fa-solid fa-images me-2 text-warning"></i> Hình ảnh liên quan</h5>
                    
                    <div id="relatedImagesCarousel" class="carousel slide shadow-sm rounded-3 overflow-hidden border" data-bs-ride="carousel">
                        <!-- Indicators/Dots -->
                        <div class="carousel-indicators mb-2">
                            @for (int i = 0; i < additionalImages.Count; i++)
                            {
                                <button type="button" data-bs-target="#relatedImagesCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                            }
                        </div>

                        <!-- Slides wrapper -->
                        <div class="carousel-inner bg-dark">
                            @for (int i = 0; i < additionalImages.Count; i++)
                            {
                                var imgObj = additionalImages[i];
                                string imgUrl = "";
                                string imgCaption = "";

                                if (imgObj.ValueKind == System.Text.Json.JsonValueKind.String)
                                {
                                    imgUrl = imgObj.GetString() ?? "";
                                }
                                else if (imgObj.ValueKind == System.Text.Json.JsonValueKind.Object)
                                {
                                    if (imgObj.TryGetProperty("url", out var urlProp))
                                    {
                                        imgUrl = urlProp.GetString() ?? "";
                                    }
                                    if (imgObj.TryGetProperty("caption", out var capProp))
                                    {
                                        imgCaption = capProp.GetString() ?? "";
                                    }
                                }

                                if (!string.IsNullOrEmpty(imgUrl))
                                {
                                    <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                                        <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="background-color: #0f172a; position: relative;">
                                            <img src="@imgUrl" class="d-block w-100 h-100" style="object-fit: contain;" alt="@imgCaption">
                                            @if (!string.IsNullOrEmpty(imgCaption))
                                            {
                                                <div class="carousel-caption d-none d-md-block px-3 py-2 rounded-2" style="background: rgba(15, 23, 42, 0.8); bottom: 40px; left: 10%; right: 10%; backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.15);">
                                                    <p class="m-0 small fst-italic text-white">@imgCaption</p>
                                                </div>
                                                <!-- Hidden element to store raw caption for script usage -->
                                                <span class="d-none raw-caption">@imgCaption</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Prev/Next Navigation Controls -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#relatedImagesCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon p-3 rounded-circle bg-dark bg-opacity-50" aria-hidden="true"></span>
                            <span class="visually-hidden">Trước</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#relatedImagesCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon p-3 rounded-circle bg-dark bg-opacity-50" aria-hidden="true"></span>
                            <span class="visually-hidden">Sau</span>
                        </button>
                    </div>

                    <!-- Caption container underneath (mobile-friendly and always readable) -->
                    <div id="carouselMobileCaption" class="py-2 px-3 bg-light border border-top-0 rounded-bottom text-center text-muted small fst-italic shadow-sm mb-3"></div>
                </div>

                <script>
                    document.addEventListener("DOMContentLoaded", function() {
                        const carousel = document.getElementById('relatedImagesCarousel');
                        const mobileCaption = document.getElementById('carouselMobileCaption');
                        
                        if (carousel && mobileCaption) {
                            function updateCaption() {
                                const activeItem = carousel.querySelector('.carousel-item.active');
                                if (activeItem) {
                                    const captionEl = activeItem.querySelector('.raw-caption');
                                    if (captionEl && captionEl.textContent.trim() !== '') {
                                        mobileCaption.textContent = captionEl.textContent;
                                        mobileCaption.style.display = 'block';
                                    } else {
                                        mobileCaption.textContent = '';
                                        mobileCaption.style.display = 'none';
                                    }
                                }
                            }
                            
                            // Initialize caption on load
                            setTimeout(updateCaption, 200);
                            
                            // Listen to slide transition completion to update caption text
                            carousel.addEventListener('slid.bs.carousel', updateCaption);
                        }
                    });
                </script>
            }

            <footer class="pt-4 border-top">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="small text-muted me-2 font-monospace fw-bold"><i class="fa-solid fa-tags me-1"></i> Từ khóa:</span>
                        <span class="badge bg-light text-secondary">PR Thương hiệu</span>
                        <span class="badge bg-light text-secondary">Bảo vệ Doanh nghiệp</span>
                    </div>
                </div>
            </footer>
        </article>

        <!-- RELATED ARTICLES (Below Article) -->
        @if (relatedPosts.Any())
        {
            <section class="mt-4 bg-white p-4 border rounded-3 shadow-sm">
                <div class="traditional-category-bar" style="margin-bottom: 15px;">
                    <span>Bài viết liên quan</span>
                </div>
                <div class="row g-3">
                    @foreach (var related in relatedPosts.Take(4))
                    {
                        <div class="col-md-6 col-12">
                            <div class="d-flex align-items-start gap-3 p-2">
                                <div style="width: 100px; height: 72px; overflow: hidden; border-radius: 6px; flex-shrink: 0; background-color: #f8fafc;">
                                    <a asp-action="PostDetail" asp-route-slug="@related.Slug">
                                        <img src="@(string.IsNullOrEmpty(related.ImageUrl) ? "https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=80&w=200" : related.ImageUrl)" class="w-100 h-100" style="object-fit: cover;" alt="@related.Title" />
                                    </a>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1" style="font-size: 0.85rem; font-weight: 700; line-height: 1.35;">
                                        <a asp-action="PostDetail" asp-route-slug="@related.Slug" class="text-decoration-none text-dark" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@related.Title</a>
                                    </h6>
                                    <span class="text-muted" style="font-size: 0.72rem;"><i class="fa-regular fa-clock me-1"></i> @related.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>

    <!-- RIGHT: SIDEBAR (30%) -->
    <div class="col-lg-4">
        <div class="sidebar-sticky">

            <!-- Widget: Bài viết cùng chuyên mục -->
            @if (relatedPosts.Any())
            {
                <div class="sidebar-widget">
                    <div class="sidebar-widget-title">
                        <i class="fa-solid fa-folder-open"></i> Cùng chuyên mục
                    </div>
                    <ul class="sidebar-news-list">
                        @foreach (var rp in relatedPosts.Take(5))
                        {
                            <li class="sidebar-news-item">
                                <div class="sidebar-news-thumb">
                                    <a asp-action="PostDetail" asp-route-slug="@rp.Slug">
                                        <img src="@(string.IsNullOrEmpty(rp.ImageUrl) ? "https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=80&w=120" : rp.ImageUrl)" alt="@rp.Title" />
                                    </a>
                                </div>
                                <div class="sidebar-news-body">
                                    <a asp-action="PostDetail" asp-route-slug="@rp.Slug">@rp.Title</a>
                                    <span class="sidebar-news-date"><i class="fa-regular fa-clock me-1"></i> @rp.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Widget: Banner Quảng cáo -->
            @if (sidebarBanners.Any())
            {
                <div class="sidebar-banner-rotator" data-delay="4500">
                    @for (int i = 0; i < sidebarBanners.Count; i++)
                    {
                        var banner = sidebarBanners[i];
                        <a href="@banner.RedirectUrl" target="_blank" class="sidebar-banner-slide @(i == 0 ? "active" : "")" title="@banner.Title">
                            <img src="@banner.ImageUrl" alt="@banner.Title" />
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="sidebar-banner">
                    <div class="sidebar-banner-placeholder">
                        <i class="fa-solid fa-rectangle-ad fs-2 mb-2 text-warning"></i>
                        <span>QUẢNG CÁO DOANH NGHIỆP</span>
                        <span class="small mt-2" style="font-size: 0.75rem; font-weight: normal; opacity: 0.8;">LIÊN HỆ PR THƯƠNG HIỆU</span>
                    </div>
                </div>
            }

            <!-- Widget: Tin mới nhất (toàn site) -->
            @if (latestPosts.Any())
            {
                <div class="sidebar-widget">
                    <div class="sidebar-widget-title">
                        <i class="fa-solid fa-newspaper"></i> Tin mới nhất
                    </div>
                    <ul class="sidebar-news-list">
                        @foreach (var lp in latestPosts.Take(5))
                        {
                            <li class="sidebar-news-item">
                                <div class="sidebar-news-thumb">
                                    <a asp-action="PostDetail" asp-route-slug="@lp.Slug">
                                        <img src="@(string.IsNullOrEmpty(lp.ImageUrl) ? "https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=80&w=120" : lp.ImageUrl)" alt="@lp.Title" />
                                    </a>
                                </div>
                                <div class="sidebar-news-body">
                                    <a asp-action="PostDetail" asp-route-slug="@lp.Slug">@lp.Title</a>
                                    <span class="sidebar-news-date">
                                        <i class="fa-regular fa-clock me-1"></i> @lp.CreatedAt.ToString("dd/MM/yyyy")
                                        @if (lp.Category != null)
                                        {
                                            <span class="ms-1 text-primary" style="font-size: 0.68rem;">| @lp.Category.Name</span>
                                        }
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Widget: Về ban biên tập -->
            <div class="sidebar-widget">
                <div class="sidebar-widget-title">
                    <i class="fa-solid fa-shield-halved"></i> Về ban biên tập
                </div>
                <div class="p-3">
                    <p class="small text-muted mb-0">Viện Phát triển Thương hiệu và Chống hàng giả là đơn vị chính thức bảo hộ thông tin doanh nghiệp. Các nội dung được đăng tải đảm bảo tính xác thực pháp lý cao.</p>
                </div>
            </div>

        </div>
    </div>
</div>
